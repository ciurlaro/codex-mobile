diff --git a/core/sqlite-compat.js b/core/sqlite-compat.js
new file mode 100644
index 0000000..f1bb47e
--- /dev/null
+++ b/core/sqlite-compat.js
@@ -0,0 +1,48 @@
+import { DatabaseSync } from 'node:sqlite';
+
+class SqliteDatabase {
+  constructor(filename) {
+    this.database = new DatabaseSync(filename);
+    this.open = true;
+  }
+
+  prepare(sql) {
+    return this.database.prepare(sql);
+  }
+
+  exec(sql) {
+    return this.database.exec(sql);
+  }
+
+  pragma(statement) {
+    return this.database.exec(`PRAGMA ${statement}`);
+  }
+
+  transaction(operation) {
+    return (...args) => {
+      this.database.exec('BEGIN IMMEDIATE');
+      try {
+        const result = operation(...args);
+        this.database.exec('COMMIT');
+        return result;
+      } catch (error) {
+        try {
+          this.database.exec('ROLLBACK');
+        } catch {
+          // Preserve the original operation failure.
+        }
+        throw error;
+      }
+    };
+  }
+
+  close() {
+    if (!this.open) return;
+    this.database.close();
+    this.open = false;
+  }
+}
+
+export default function Database(filename) {
+  return new SqliteDatabase(filename);
+}
